(library
 (name mgen_nn)
 ; The common parts of the neural-net sources. Each of the three eras holds a model in two
 ; layers — the JAX model and its integer twin above the seam, the [Model] and the circuit
 ; below it — and what is one thing across the eras stands here one time: the units, the
 ; fixed-point rules the circuits read and the tables they elaborate. NOTHING HERE
 ; QUANTIZES and nothing here draws in float: those are rules of a checkpoint and of a
 ; sampling policy, and both live above the seam with the twins. What only rhymes between
 ; the eras — the op vocabularies, the schedules, the parameter structures — stays in the
 ; era libraries, and the op and schedule abstraction is an open question by standing
 ; rule.
 (libraries base stdio hardcaml hardcaml_waveterm mgen_core)
 (flags
  (:standard -open Mgen_core))
 (inline_tests
  (flags
   (:standard -source-tree-root .)))
 (preprocess
  (pps ppx_hardcaml ppx_expect ppx_sexp_conv)))
