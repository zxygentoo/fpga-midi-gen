; The one line that names the era of the seat. [Top] speaks of [Source] and of
; [Elaboration] and of nothing narrower, thus the library it opens decides which model the
; bitstream carries; the eras before it stay in the tree untouched.

(library
 (name mgen_nexys4)
 (modules top)
 (libraries hardcaml mgen_board mgen_diffusion)
 (flags
  (:standard -open Mgen_board -open Mgen_diffusion)))

(executable
 (name gen_verilog)
 (modules gen_verilog)
 (libraries core core_unix hardcaml jane_rope mgen_diffusion mgen_nexys4))

; The out-of-context probe: one unit alone, for a timing and utilization reading before
; the machine around it exists. It carries no model — the column array takes its weights
; as ports — thus it names no checkpoint.

(executable
 (name gen_probe)
 (modules gen_probe)
 (libraries core core_unix hardcaml jane_rope mgen_nn mgen_diffusion))
