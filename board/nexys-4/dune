; THE TOP LEVEL NAMES NO ERA. It takes the source as an argument, thus this library
; opens no era's library and every era can elaborate its own top: `gen_verilog` names era
; six for the board, and each era's gate driver names its own for the netlist gate of
; `jax/tests/test_parity.py`.

(library
 (name mgen_nexys4)
 (modules top)
 (libraries hardcaml mgen_board mgen_core)
 (flags
  (:standard -open Mgen_board)))

(executable
 (name gen_verilog)
 (modules gen_verilog)
 (preprocess
  (pps ppx_let))
 (libraries
  core
  core_unix
  core_unix.command_unix
  hardcaml
  jane_rope
  mgen_diffusion
  mgen_nexys4))

; The out-of-context probe: one unit alone, for a timing and utilization reading before
; the machine around it exists. It carries no model — the column array takes its weights
; as ports — thus it names no checkpoint.

(executable
 (name gen_probe)
 (modules gen_probe)
 (libraries core core_unix hardcaml jane_rope mgen_nn mgen_diffusion))
